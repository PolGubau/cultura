# Copy to .env.local and complete in an editor. These NEXT_PUBLIC values are public.
# Use a project with the culture migrations applied; never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The city ID, not a festival ID. Festival mode is configured in the admin.
CULTURE_CITY_ID=mataro
