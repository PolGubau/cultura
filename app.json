{
  "expo": {
    "name": "Mataró Cultura",
    "slug": "app",
    "scheme": "les-santes",
    "version": "1.1.2",
    "icon": "./assets/culture-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/culture-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#9f1239",
      "dark": {
        "image": "./assets/culture-icon.png",
        "backgroundColor": "#9f1239"
      }
    },
    "ios": {
      "bundleIdentifier": "com.polgubau.lessantes",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/culture-icon.png",
        "dark": "./assets/culture-icon.png",
        "tinted": "./assets/culture-monochrome.png"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "La app utilitza la teva ubicació per mostrar-la al mapa cultural de Mataró.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.polgubau.lessantes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/culture-adaptive.png",
        "monochromeImage": "./assets/culture-monochrome.png",
        "backgroundColor": "#9f1239"
      },
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/culture-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "dffc30d5-6870-47b8-979f-a842d6848eb5"
      }
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "La app utilitza la teva ubicació per mostrar-la al mapa cultural de Mataró."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "La app vol afegir actes culturals al teu calendari."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/culture-monochrome.png",
          "color": "#9f1239",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "ara",
              "title": "Ara",
              "subtitle": "Actes en curs",
              "icon": "time",
              "params": {
                "href": "/(culture)/ara"
              }
            },
            {
              "id": "agenda",
              "title": "Agenda",
              "subtitle": "Tots els actes",
              "icon": "date",
              "params": {
                "href": "/(culture)"
              }
            },
            {
              "id": "mapa",
              "title": "Mapa",
              "subtitle": "Mapa cultural de Mataró",
              "icon": "location",
              "params": {
                "href": "/(culture)/mapa"
              }
            }
          ]
        }
      ]
    ],
    "owner": "polgubau",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dffc30d5-6870-47b8-979f-a842d6848eb5"
    }
  }
}
