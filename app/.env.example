# Origen HTTPS de la web cultural desplegada, sin rutas ni barra final.
# Para un emulador Android local puede usarse http://10.0.2.2:3000.
# En un dispositivo físico, utiliza una dirección accesible desde el dispositivo.
EXPO_PUBLIC_CULTURE_API_URL=lessantes.polgubau.com

# Opcional: clave pública de MapTiler; sin ella se usa OpenFreeMap.
EXPO_PUBLIC_MAPTILER_KEY=

# EXPO_PUBLIC_* se incluye en la aplicación: nunca poner secretos aquí.
# El cliente cultural no necesita FESTIVAL_ID ni credenciales de Supabase.
# Las herramientas históricas de seed tienen configuración independiente.
